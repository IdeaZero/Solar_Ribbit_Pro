&i2c2_default {
	group1 {
		psels = <NRF_PSEL(TWIM_SDA, 0, 8)>, <NRF_PSEL(TWIM_SCL, 0, 7)>;
	};
};

&i2c2_sleep {
	group1 {
		psels = <NRF_PSEL(TWIM_SDA, 0, 8)>, <NRF_PSEL(TWIM_SCL, 0, 7)>;
	};
};

&button0 {
	gpios = <&gpio0 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
};

&led1 {
	gpios = <&gpio0 26 0>;
	label = "3v3 enable";
};
&led2 {
	gpios = <&gpio0 10 0>;
	label = "load ena";
};